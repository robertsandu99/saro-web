# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
SARO_DB_CONN=postgresql+asyncpg://saroweb:saroweb@localhost:5432/saroweb

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SARO_SECRET_KEY=change-me-to-a-real-secret-key-at-least-32-chars

# ── Application ───────────────────────────────────────────────────────────────
SARO_DEBUG=false
